# Public browser configuration: use a publishable key, NEVER a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=
# Server only. Do not prefix either variable below with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional anti-bot protection. Configure both keys to enable Turnstile.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
